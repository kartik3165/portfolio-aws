# Backend API URL — required for production build (set to your API Gateway URL)
# Local dev falls back to http://localhost:8000 via Vite proxy if empty.
VITE_API_URL=http://localhost:8000

# Site base URL — used for share links / canonical URLs
VITE_SITE_URL=https://example.com

# Image/CDN base — R2 public URL (used for Hero fallback, About image, markdown sample)
# Keep in sync with core-backend R2_PUBLIC_BASE_URL
VITE_IMG_BASE_URL=https://img.example.com

# Optional Google Analytics 4 — leave empty to disable
VITE_GA_ID=
