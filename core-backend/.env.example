# Backend Configuration
# Copy to .env and fill in your values: cp .env.example .env
AWS_REGION=ap-south-1

# DynamoDB Tables
BLOG_TABLE=BlogsTable
COMMENTS_TABLE=BlogCommentsTable
SKILL_TABLE=SkillsTable
PROJECTS_TABLE=ProjectsTable
PROFILE_TABLE=ProfileTable

# Security
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=portfolio-api
JWT_AUDIENCE=portfolio-admin
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# TOTP encryption key (Fernet, base64). Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=change-me-to-a-fernet-key

# R2 (Cloudflare) - only needed for uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://img.reportgenai.in

# Admin Credentials (used once by /admin/auth/init)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Bootstrap secret for one-time /admin/auth/init
BOOTSTRAP_SECRET=change-me-before-deploy

# Local dev only: uncomment to use dynamodb-local instead of real AWS
# DYNAMODB_ENDPOINT=http://localhost:8001
